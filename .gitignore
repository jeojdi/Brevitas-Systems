# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
node_modules/
dashboard/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# built dashboard bundle (regenerated by `npm run build:dashboard`)
/public/dashboard/

# local scratch working files (schema snapshots, throwaway analysis)
/scratchpad/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
.env.production
.env.development
# Allow the example file
!.env.example

# vercel
.vercel

# local coding-agent artifacts
.claude/

# typescript
*.tsbuildinfo
next-env.d.ts

# Test and setup files - NEVER commit these
test-*.js
setup-*.js
*-test.js
*-setup.js
*.test.js
*.setup.js

# build artifacts - NEVER commit these
dist/

# python
__pycache__/
*.pyc

# secrets & local databases - NEVER commit these.
# api/.secret_key and api/brevitas.db were committed once (blobs ae18fc3b and
# dc674de5, still reachable from main) before these rules existed; the key is burned
# and must never be reused. See "Retired and exposed key material" in
# docs/CREDENTIAL_SECURITY.md. The patterns are broadened past the two exact paths so
# a renamed key file or a local SQLite copy cannot repeat it.
.secret_key
*.secret_key
*.db
*.sqlite
*.sqlite3

# token_efficiency_model runtime cache
token_efficiency_model/experiments/.delta_memory_store.json

# api runtime artifacts / secrets (added during PR #5 merge cleanup)
api/.secret_key
api/brevitas.db
api/__pycache__/
**/__pycache__/
*.pyc
dashboard/node_modules/

# large source GIFs (converted to MP4 for web — keep only the mp4s)
public/assets/*.gif

# Python build artifacts
*.egg-info/
.venv/

ponytail/
